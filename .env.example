# Copy to .env.local for local work; set the same names in Vercel for deploys.

# Contact form email delivery (src/app/api/contact/route.ts, src/lib/mailer.ts).
# Production needs either SMTP or Resend. With neither, the form returns an
# error instead of silently dropping the lead (in development it just skips the email).
# Every submission is also saved to Firestore (siteLeads, shown in /admin/leads) when Firebase
# is configured, so a lead is kept even if the email fails or lands in spam.

# SMTP - used whenever host, user and password are all set. The studio mailbox
# is contact@contact.mim.archi on Titan (Hostinger): host smtp.titan.email,
# port 465 (SSL). The password is the mailbox password; keep it in .env.local
# and Vercel only, never in git.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to true on port 465, false (STARTTLS) on other ports.
SMTP_SECURE=

# Resend - used only when SMTP is not configured.
RESEND_API_KEY=

# Optional. Sender address. Defaults to "Mimar Studios Website <SMTP_USER>" over
# SMTP (most servers, Titan included, only send as the signed-in mailbox), or to
# "Mimar Studios Website <site@mim.archi>" over Resend (must be on a domain verified
# in Resend; its test sender onboarding@resend.dev only delivers to your own Resend account email).
CONTACT_FROM_EMAIL=

# TURNSTILE-DISABLED (no Cloudflare access yet): the checkbox is switched off, so none of these
# are read. Uncomment them along with the code marked TURNSTILE-DISABLED.
# Contact form bot check: Cloudflare Turnstile, the "I'm human" checkbox.
# Create a widget at https://dash.cloudflare.com -> Turnstile (widget mode:
# Managed) and add every hostname the form runs on, including preview
# domains. Required in production: without the secret the form refuses
# submissions (in development it just skips the check). The site key is public
# and is inlined at BUILD time, so set it before deploying.
# For local work Cloudflare publishes always-pass test keys:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional but recommended in production: shared rate-limit counters (a free
# Upstash Redis database; use its REST URL and token). Without these the
# contact form's rate limits are tracked per serverless instance only, which
# only slows a simple flood down.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Defaults to contact.email in src/lib/site-config.ts (info@mim.archi).
# Set on a staging/preview deploy to send test leads to a test inbox instead.
CONTACT_TO_EMAIL=

# --- Staff portal (/admin) + dynamic careers/blog (Firebase) ---------------
# Server-only Firebase Admin credentials. Create a service account in Firebase
# console -> Project settings -> Service accounts -> Generate new private key,
# and copy project_id, client_email and private_key from the JSON, in .env.local and
# Vercel only - never git. FIREBASE_PRIVATE_KEY is forgiving: the PEM with real line
# breaks, on one line with literal \n sequences, wrapped in quotes (Vercel keeps them),
# or even the whole downloaded JSON file all work. If it is unusable the server logs
# "[firebase] FIREBASE_PRIVATE_KEY is not a PEM private key..." and /admin shows "not configured".
# Without these the site renders exactly as before (no jobs, no extra posts) and
# /admin sign-in is disabled.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional. Defaults to <project-id>.firebasestorage.app. Used for blog cover images.
FIREBASE_STORAGE_BUCKET=
# Firebase console -> Project settings -> General -> Web API key. Only used
# server-side to check staff passwords (identitytoolkit REST); not sent to the browser.
FIREBASE_WEB_API_KEY=

# Blog generator (/admin/blog/generate). Use Gemini (startup credits) or Claude - set ONE key, or both and
# choose with AI_PROVIDER. With no AI_PROVIDER, Gemini is used when GEMINI_API_KEY is set, otherwise Claude.
# Keep keys server-side only (.env.local and Vercel), never in browser code.
# AI_PROVIDER=gemini
#
# Gemini: key from https://aistudio.google.com/apikey (restrict it to the Gemini API, set a billing alert).
# Research uses Grounding with Google Search (newest models only; the default supports it).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
#
# Claude: key from https://console.anthropic.com (prepaid credit; set a spend limit).
ANTHROPIC_API_KEY=
# Optional model override. Default: claude-opus-5-5. A draft costs roughly a few tenths of a dollar
# (web search + ~1,500 words); a cheaper model such as claude-sonnet-5-5 lowers that at some cost in quality.
# ANTHROPIC_MODEL=claude-opus-5-5
# Optional. Drafts allowed per day across the whole site (manual + scheduled). Default 10.
# BLOG_GENERATION_DAILY_LIMIT=10
# Optional. APPROVERS: emailed (To) when a scheduled draft is waiting for approval. Comma separated.
# Default: hr@mim.archi. Each person must have an admin or editor account to approve.
# BLOG_NOTIFY_EMAIL=muhammad.farooq@mim.archi,rabia.zaman@mim.archi
# Optional. Copied (CC) on that email for information only; they do not need an account. "none" = nobody.
# Default: info@mim.archi
# BLOG_NOTIFY_CC=info@mim.archi
# Optional. Base URL for the approval link in that email. Default: https://mim.archi
# (only set this to test on a preview deployment, e.g. https://your-preview.vercel.app).
# ADMIN_BASE_URL=
# Optional. Automatic topic planning on the schedule (default on; set to false to only write queued topics).
# BLOG_AUTO_TOPICS=true
# Optional. Stop planning new drafts while this many AI drafts are still waiting for review. Default 6.
# BLOG_MAX_PENDING_DRAFTS=6

# Scheduled drafting and the monthly blog report (Vercel Cron -> /api/cron/generate-blog and
# /api/cron/blog-report). Any long random string; Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Google Search Console (src/lib/search-console.ts): real Google searches for the automatic blog
# keywords, and Google clicks/positions on /admin/blog/performance. Without it the AI picks keywords.
# The property exactly as Search Console names it: sc-domain:mim.archi (domain) or https://mim.archi/ (URL prefix).
# The Firebase service account (FIREBASE_CLIENT_EMAIL) is used: add that email as a Restricted user of the
# property, and enable the Search Console API in its Google Cloud project. See ADMIN_PORTAL.md.
# GSC_SITE_URL=sc-domain:mim.archi
# Optional. A different service account for Search Console (the key may be the whole JSON file).
# GSC_CLIENT_EMAIL=
# GSC_PRIVATE_KEY=
# Optional, local end-to-end tests only: keep test counts out of the real siteBlogDaily collection.
# SITE_BLOG_DAILY_COLLECTION=siteBlogDailyTest

# Optional, local end-to-end tests only: keep test leads out of the real siteLeads collection.
# SITE_LEADS_COLLECTION=siteLeadsTest

# Cookie-free visit tracking (src/lib/visits.ts, /api/track). Visitors are recognised only by a hash
# of IP + browser that changes every day; nothing is stored in the browser. REQUIRED in production:
# without a secret, tracking is switched off (it never falls back to a guessable key). Any long random
# string, e.g. generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# VISITOR_HASH_SECRET=
# Optional. Set to "off" to stop recording visits (leads still save their request details).
# VISIT_TRACKING=on
# Optional, local end-to-end tests only: keep test visits out of the real siteVisitors collection.
# SITE_VISITORS_COLLECTION=siteVisitorsTest

# Careers application form (/careers/apply, src/app/api/careers/apply/route.ts). Uses the same mail settings as the
# contact form. Applications are saved to Firestore (siteApplications, shown in /admin/applications) before the email.
# Optional. Where applications are emailed. Defaults to hr@mim.archi; set it on a staging deploy to use a test inbox.
# CAREERS_TO_EMAIL=
# Optional, local end-to-end tests only: keep test applications out of the real siteApplications collection.
# SITE_APPLICATIONS_COLLECTION=siteApplicationsTest
